---
import { asset } from "../lib/url";
import "../styles/global.css";

const title = "Stack Tower";
const description = "A small browser game.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={asset("card.png")} />
  </head>
  <body>
    <nav aria-label="Skip links">
      <a class="skip-link" href="#play">Skip to the game</a>
    </nav>

    <main data-game>
      <header class="hud">
        <h1>{title}</h1>

        <button class="restart" type="button" data-restart aria-label="New game">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M20.5 12a8.5 8.5 0 1 1-2.49-6.01" fill="none" />
            <path d="M20.5 3.5v5h-5" fill="none" />
          </svg>
        </button>
      </header>

      <p class="readout" aria-live="polite" data-score>0</p>

      <div
        id="play"
        class="field"
        data-field
        tabindex="0"
        role="application"
        aria-label={title}
      >
        <div class="tower" data-tower></div>
        <div class="slider" data-slider></div>
      </div>

      <footer class="stats">
        <p class="stat stat-perfect">
          <span class="stat-label">Perfect</span>
          <span class="stat-value" data-perfect>0</span>
        </p>

        <p class="stat stat-best">
          <span class="stat-label">Best</span>
          <span class="stat-value" data-best hidden></span>
        </p>
      </footer>
    </main>

    <script>
      import { render } from "../lib/render";
      import { createGame, drop, tick } from "../lib/rules";
      import { readBest, writeBest } from "../lib/storage";

      const root = document.querySelector("[data-game]");
      const field = document.querySelector<HTMLElement>("[data-field]");
      const restart = document.querySelector<HTMLElement>("[data-restart]");

      if (root && field) {
        // Safari in private browsing throws on the property itself, not on use.
        const store = (() => {
          try {
            return window.localStorage;
          } catch {
            return null;
          }
        })();

        let best = readBest(store);
        let state = createGame();
        let last = performance.now();

        const paint = () => render(root, state, best);

        // A height you reached is a height you reached, whether the run ended by
        // a miss or because you walked away from it.
        const bankBest = () => {
          if (best === null || state.score > best) {
            best = state.score;
            writeBest(store, best);
          }
        };

        const act = () => {
          if (state.status === "over") {
            state = createGame();
          } else {
            state = drop(state);
            if (state.status === "over") bankBest();
          }
          paint();
        };

        const newGame = () => {
          bankBest();
          state = createGame();
          paint();
          // Hand the keyboard back to the field so Space still drops.
          field.focus();
        };

        restart?.addEventListener("click", newGame);

        field.addEventListener("pointerdown", (event) => {
          event.preventDefault();
          // preventDefault suppresses the default focus, so take it explicitly:
          // without this the keydown handler below never fires and Space scrolls.
          field.focus();
          act();
        });

        field.addEventListener("keydown", (event) => {
          if (event.key !== " " && event.key !== "Enter") return;
          event.preventDefault();
          act();
        });

        const frame = (now: number) => {
          state = tick(state, now - last);
          last = now;
          paint();
          requestAnimationFrame(frame);
        };

        paint();
        requestAnimationFrame(frame);
      }
    </script>
  </body>
</html>
