node_modules/
dist/
*.log

# Astro's generated types — rebuilt on every `astro dev`/`astro build`, and
# oxlint reads this file as its ignore list, so keeping it here also stops the
# lint sensor reporting on generated code.
.astro/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/

# subagent-driven-development scratch: ledgers, briefs, review packages
.superpowers/

# the week's brief, kept locally; the course site is where it lives
*.pdf
